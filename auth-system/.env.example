# Copy to .env and fill in production secrets
APP_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=auth_system
DB_USER=auth_app_user
DB_PASS=REPLACE_WITH_STRONG_PASSWORD

COOKIE_SECURE=true
SESSION_IDLE_TIMEOUT=1800

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_WINDOW_SEC=900
RATE_LIMIT_LOCKOUT_SEC=900
RATE_LIMIT_PEPPER=REPLACE_WITH_64_HEX_CHARS

# DocQ&A SSO Integration
DOCQA_URL=https://your-docqa-frontend.vercel.app
DOCQA_SSO_SECRET=REPLACE_WITH_64_HEX_CHARS
