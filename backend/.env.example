# Gemini AI (Required)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-2.5-flash

# Auth & Sessions (Required)
JWT_SECRET=your_long_random_jwt_secret_here
AUTH_DB_PATH=./auth.db

# Email Provider Configuration (At least one provider required for Email OTP delivery)
# Option 1: Resend HTTPS API (Recommended for Render & cloud hosts, works over port 443)
# Note: For production delivery to all inboxes, verify your domain at resend.com/domains
RESEND_API_KEY=
RESEND_FROM=DocQ&A <notifications@yourverifieddomain.com>

# Option 2: Brevo HTTPS API (Alternative HTTPS delivery over port 443)
# BREVO_API_KEY=
# BREVO_FROM=noreply@yourdomain.com

# Option 3: Standard SMTP (Gmail App Password, SendGrid, Mailgun, Amazon SES)
# Note: Render free tier blocks outbound SMTP ports 25, 465, 587; use Resend or Brevo on Render.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_character_app_password
# SMTP_FROM=your_email@gmail.com

# CORS Configuration
ALLOWED_ORIGINS=*
