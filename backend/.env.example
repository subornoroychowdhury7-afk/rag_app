# Gemini AI (Required)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-2.5-flash

# HuggingFace Inference API (Optional — enables multi-model fallback chain)
# Get your free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_token_here
# Comma-separated list of HuggingFace model IDs to try in order (optional override)
# HF_MODELS=mistralai/Mixtral-8x7B-Instruct-v0.1,HuggingFaceH4/zephyr-7b-beta
# Max new tokens per HF response (default: 2048)
# HF_MAX_NEW_TOKENS=2048
# Timeout in seconds for each HF model call (default: 60)
# HF_TIMEOUT=60

# CORS Configuration
ALLOWED_ORIGINS=*
